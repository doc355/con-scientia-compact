+def via_userhost(t: dict) -> str | None:
+    """`via` validated to exactly `ssh:user@host`; anything else is treated as absent (and the probe says so)."""
+    m = VIA_RE.match(str(t.get("via") or ""))
+    return m.group(1) if m else None
+
+def via_url(t: dict) -> str:
+    return str(t.get("via_url") or f"http://127.0.0.1:{int(t['port'])}{t.get('path') or '/'}")
+
+def probe_via_ssh(t: dict) -> tuple[bool | None, str, float]:
+    """LINK-SSH-001. (up, reason, ms) with up=None meaning BLIND: ssh itself did not get through, so nothing is
+    known about the service. ssh exit 255 is ssh's own failure code; any other code is curl's, run on the far box."""
+    t0 = time.time()
+    uh = via_userhost(t)
+    if not uh:
+        return None, f"via malformed: {str(t.get('via'))[:60]} (want ssh:user@host)", 0.0
+    url = via_url(t)
+    args = ["ssh", "-n", "-o", "BatchMode=yes", "-o", f"ConnectTimeout={max(1, int(TIMEOUT_S * 2))}", uh,
+            f"curl -s -m {int(TIMEOUT_S)} -o /dev/null -w '%{{http_code}}' {url}"]
+    try:
+        r = subprocess.run(args, capture_output=True, text=True, timeout=TIMEOUT_S * 4 + 2)
+    except subprocess.TimeoutExpired:
+        return None, f"ssh {uh}: no answer in {TIMEOUT_S * 4 + 2:.0f}s (BLIND)", round((time.time() - t0) * 1000)
+    except Exception as e:
+        return None, f"ssh {uh}: {type(e).__name__}: {str(e)[:100]} (BLIND)", round((time.time() - t0) * 1000)
+    ms = round((time.time() - t0) * 1000)
+    err = (r.stderr or "").strip()
+    if r.returncode == 255:
+        if SSH_CHECK_TEXT in err:
+            m = SSH_URL_RE.search(err)
+            return None, f"ssh {uh}: Tailscale check-mode re-auth needed — Doc's click: {m.group(0) if m else 'url not shown'} (BLIND)", ms
+        return None, f"ssh {uh}: {err.splitlines()[-1][:120] if err else 'exit 255'} (BLIND)", ms
+    code_txt = (r.stdout or "").strip().strip("'")
+    if r.returncode != 0:
+        return False, f"via ssh {uh}: curl exit {r.returncode} on {url} (nothing listening there)", ms
+    try: code = int(code_txt)
+    except ValueError: return False, f"via ssh {uh}: curl answered '{code_txt[:20]}' on {url}", ms
+    if code == 0: return False, f"via ssh {uh}: no HTTP answer on {url}", ms
+    return (200 <= code < 500), f"http {code} via ssh {uh}", ms
 
